[Unit]
Description=Luma private command transport firewall
Before=luma-tailscaled.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/nft -f /etc/luma/tailscale.nft
RemainAfterExit=yes
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Retain rules when stopped; never open a transient fail-open window.
