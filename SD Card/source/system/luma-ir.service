[Unit]
Description=Luma bounded USB infrared broker
Requires=luma-ir.socket
After=luma-ir.socket

[Service]
Type=exec
User=luma-ir
Group=luma-ir
ExecStart=/opt/luma/venv/bin/luma-ir
WorkingDirectory=/opt/luma
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
# Needs the real USB LIRC nodes. DAC grants access only to the dedicated account;
# the worker additionally checks USB sysfs identity, node type, rdev and features.
PrivateDevices=no
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/run
InaccessiblePaths=-/var/lib/luma -/var/lib/luma-tailscale -/etc/luma -/run/luma-tailscale -/run/luma-tailscale-setup.sock -/run/luma-network.sock -/run/dbus -/run/systemd/private
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TasksMax=24
MemoryMax=96M
CPUQuota=30%
KillMode=control-group
TimeoutStopSec=5
Restart=on-failure
RestartSec=3
