[Unit]
Description=Luma protected application-update broker
Requires=luma-update.socket

[Service]
Type=exec
ExecStart=/opt/luma/venv/bin/luma-update-broker
User=root
Group=root
Environment=PYTHONDONTWRITEBYTECODE=1
# The broker's status/lock files are explicitly 0600 and update payloads stay
# inside private staging directories. Installed Python modules and frontend
# assets must be readable by the unprivileged Luma services after the switch.
UMask=0022
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# The atomic release pointer and its temporary sibling both live directly in
# /opt. Allowing only /opt/luma (a symlink) and /opt/luma-releases leaves the
# parent read-only under ProtectSystem=strict and strands stopped services.
ReadWritePaths=/opt
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TasksMax=24
MemoryMax=192M
CPUQuota=35%
KillMode=control-group
TimeoutStopSec=5
Restart=on-failure
RestartSec=3
