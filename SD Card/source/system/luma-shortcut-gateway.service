[Unit]
Description=Luma restricted private Shortcut command gateway (opt-in)
After=luma-api.service
Requires=luma-api.service
# Deliberately not enabled until the owner configures private HTTPS on the Pi.

[Service]
Type=exec
DynamicUser=yes
User=luma-shortcut
WorkingDirectory=/opt/luma
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/luma/venv/bin/luma-shortcut-gateway
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadOnlyPaths=/run
ProtectHome=yes
InaccessiblePaths=-/var/lib/luma -/var/lib/luma-tailscale -/etc/luma -/run/luma-tailscale -/run/luma-tailscale-setup.sock -/run/dbus -/run/luma-network.sock -/run/systemd/private
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# AF_UNIX is required for Python asyncio's internal socketpair.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
IPAddressDeny=any
IPAddressAllow=localhost
TasksMax=32
MemoryMax=192M
CPUQuota=30%

[Install]
WantedBy=multi-user.target
